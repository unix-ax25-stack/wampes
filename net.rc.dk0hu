# @(#) $Header: /Users/thomas/direwolf-libax25-agwpe/wampes-import/wampes-cvs/wampes/net.rc.dk0hu,v 1.21 1993/09/06 11:37:43 deyke Exp $

hostname     dk0hu
ax25 mycall  dk0hu
ip address   dk0hu
netrom ident "#boeb"

# tnc0: 2 m

attach asy 0 0 kissi tnc0 0 256 9600
param tnc0  1  30   # txdelay
param tnc0  2  31   # persistence
param tnc0  3  30   # slottime
param tnc0  4   3   # txtail
param tnc0  5   0   # full duplex
param tnc0 12   0   # echo
param tnc0 13   1   # rxdelay

attach axip                     # ax.25 over host ip
attach ipip                     # ip over host ip
attach netrom                   # ip over netrom

ax25 route add axip default

axip route add db0sao   192.1.1.1               # db0sao
axip route add df3du-1  15.138.80.94            # hpbidmp2.bbn.hp.com
axip route add dh8saw-1 15.138.72.40            # hpbbis90.bbn.hp.com
axip route add dj3eg-1  15.136.170.163          # hpbmosm0.bbn.hp.com
axip route add dk5sg    15.15.80.34             # mdddhd.fc.hp.com
axip route add dl1sbl-1 15.136.56.132           # hpbeo20.bbn.hp.com
axip route add dl2sel-1 15.136.175.24           # hpcsmus.bbn.hp.com
axip route add dl4sas-1 15.136.216.106          # hpbid1gf.bbn.hp.com
axip route add dl4sel-1 15.136.136.223          # isoit041.bbn.hp.com
axip route add dl5ue-1  15.8.62.21              # schiefer.hpl.hp.com

route add  dk5sg-u          ipip     15.15.80.34
route add  dl5ue-1          ipip     15.8.62.21
route add  dl4sel-1         ipip     15.136.136.223
route add  dl4sel           tnc0
route add  dl4sas-1         ipip     15.136.216.106
route add  dl2sel-1         ipip     15.136.175.24
route add  dl2sel           tnc0
route add  dl1sbl-1         ipip     15.136.56.132
route add  dk5sg            ipip     15.15.80.34
route add  dj3eg-1          ipip     15.136.170.163
route add  dh8saw-1         ipip     15.138.72.40
route add  df3du-1          ipip     15.138.80.94
route addp dd2fx            tnc0
route add  44.142.52/23     ipip     192.1.1.1
route add  44.130/16        ipip     192.1.1.1

arp add dd2fx  ax25 dd2fx-2
arp add dl2sel ax25 dl2sel
arp add dl4sel ax25 dl4sel

source /tcp/netrom_links

# netrom broadcast tnc0  nodes
# netrom broadcast axip  nodes

domain usegethostby on
echo refuse
icmp trace on
ip rtimer 300
ip ttl 30
log /tcp/net.log
tcp irtt 60000
tcp mss 216
tcp window 2048

start discard
start domain
start echo
start remote
start tcpgate convers unix:/tcp/sockets/convers
start tcpgate smtp

source /tcp/net.rc.local
