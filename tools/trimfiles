#! /bin/sh

# @(#) $Header: /Users/thomas/direwolf-libax25-agwpe/wampes-import/wampes-cvs/wampes/tools/trimfiles,v 1.8 1994/01/09 16:23:29 deyke Exp $

PATH=/usr/5bin:$PATH
tmp=tmp$$
if [ ! -f .trimtime ] ; then
  touch 0101000070 .trimtime
fi
for i in `find * -prune -type f '(' \
	-name '*.c'          -o \
	-name '*.conf'       -o \
	-name '*.h'          -o \
	-name 'Makefile'     -o \
	-name 'README'       -o \
	-name 'configure'    -o \
	-name 'doc'          -o \
	-name 'fixnetrc'     -o \
	-name 'genupd'       -o \
	-name 'intro.txt'    -o \
	-name 'ip_routes'    -o \
	-name 'net.rc*'      -o \
	-name 'netrom_links' -o \
	-name 'notes'        -o \
	-name 'smack.ms'        \
	')' -newer .trimtime -print`
do
  echo "$i \c"
  trim -s $i > $tmp
  if cmp -s $i $tmp ; then
    rm -f $tmp
    echo no change
  else
    mv $tmp $i
    echo done
  fi
done
echo x > .trimtime
