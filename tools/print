#! /bin/ksh

# @(#) $Header: /Users/thomas/direwolf-libax25-agwpe/wampes-import/wampes-cvs/wampes/tools/print,v 1.6 1996/08/11 18:17:09 deyke Exp $

if [[ -n "$1" ]]; then
	files="setup $*"
else
	files="$(< filelist)"
fi

case ${0##*/} in
nprint)
	cat $files | tbl -TX | nroff -mm | col
	;;
tprint)
	cat $files | tbl | troff -mm
	;;
aprint)
	cat $files | groff -p -t -mgm -Tascii
	;;
pprint)
	cat $files | groff -p -t -mgm -Tps
	;;
*)
	echo $0 not recognized
	exit 1
	;;
esac
