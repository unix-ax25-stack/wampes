#! /bin/csh -f

# @(#) $Header: /Users/thomas/direwolf-libax25-agwpe/wampes-import/wampes-cvs/wampes/tools/Attic/tcprcs,v 1.1 1992/09/05 08:14:59 deyke Exp $

set nonomatch
set tmp = /tmp/tmp.$$
rm -f $tmp
tcpremove
foreach rcsdir (`find ~/tcp -type d -name RCS -print`)
  cd $rcsdir/..
  set dir = `pwd`
  foreach file (`find * -prune -type f -print`)
    if (! -f RCS/${file},v) echo $rcsdir/${file},v is missing
  end
  foreach file (RCS/*)
    (rcsdiff $* $file > $tmp) >& /dev/null
    if (! -z $tmp) then
      echo ' '
      echo ============== $dir/$file ==============
      echo ' '
      cat $tmp
    endif
  end
end
rm -f $tmp
