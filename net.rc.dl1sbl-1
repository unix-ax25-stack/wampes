# @(#) $Id: net.rc.dl1sbl-1,v 1.40 1999/04/25 16:56:36 deyke Exp $

hostname     dl1sbl-1
ax25 mycall  dl1sbl-1
ip address   dl1sbl-1
netrom ident "#BOEB1"

attach axip                     # ax.25 over host ip
attach ipip                     # ip over host ip
attach ipip ipudp udp 20004     # ip over host udp
attach netrom                   # ip over netrom
attach ni ni dl1sbl             # ip to host ip

ax25 route add axip default

axip route add db0fho   db0fho
axip route add df3du-1  15.138.80.94            # hpbidmp2.bbn.hp.com
axip route add df9sr-1  15.136.35.218           # bmdjw.bbn.hp.com
axip route add dh8saw-1 15.138.72.40            # hpbbis90.bbn.hp.com
axip route add dj3eg-1  15.136.160.150          # hpbmosm0.bbn.hp.com
axip route add dk0hu    15.138.33.250           # hp0hu.bbn.hp.com
axip route add dl4sas-1 15.136.157.138          # hpbid1gf.bbn.hp.com
axip route add dl4sel-1 15.136.162.7            # hpbbis45.bbn.hp.com

route add  44.130.0.0/16        ipip     15.138.33.250        1 0
route add  44.130.12.0/24       ipudp    15.254.48.2          1 0
route add  44.143.0.0/16        ipip     15.138.33.250        1 0
route add  db0sao-u.ampr.org    ipip     15.138.33.250        1 2147483
route add  db0sao.ampr.org      ipip     15.138.33.250        1 2147483
route add  df3du-1.ampr.org     ipip     15.138.80.94         1 2147483
route add  df9sr-1.ampr.org     ipip     15.136.35.218        1 2147483
route add  dh8saw-1.ampr.org    ipip     15.138.72.40         1 2147483
route add  dj3eg-1.ampr.org     ipip     15.136.160.150       1 2147483
route add  dk0hu-u.ampr.org     ipip     15.138.33.250        1 2147483
route add  dk0hu.ampr.org       ipip     15.138.33.250        1 2147483
route add  dl1sbl.ampr.org      ni       0                    1 2147483
route add  dl4sas-1.ampr.org    ipip     15.136.157.138       1 2147483
route add  dl4sel-1.ampr.org    ipip     15.136.162.7         1 2147483
route add  dl4sel.ampr.org      ipip     15.138.33.250        1 2147483

source /tcp/netrom_links

netrom broadcast axip nodes

flexnet link add dk0hu

domain usegethostby on
echo accept
icmp trace on
ip rtimer 300
ip ttl 30
log /tcp/net.log
tcp irtt 60000
tcp mss 216
tcp window 2048

start discard
start domain
start echo
start ftp
start sntp
start time

source /tcp/net.rc.local
