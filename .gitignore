# erzeugt von src/Makefile (FORCE-Regel), traegt den Commit fuer das Banner.
# Getrackt gehoert sie nicht: die Pruefung "git diff --quiet HEAD", aus der das
# "+" faellt, sieht sie mit an, und die eingecheckte Fassung kann nie zu der
# passen, die gerade erzeugt wird - sie nennt ja einen anderen Commit. Das "+"
# stand damit dauerhaft und sagte nichts mehr aus.
src/version_git.h

