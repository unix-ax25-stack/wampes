# @(#) $Header: /Users/thomas/direwolf-libax25-agwpe/wampes-import/wampes-cvs/wampes/net.rc.dk5sg,v 1.12 1993/03/30 17:23:18 deyke Exp $

hostname     dk5sg
ax25 mycall  dk5sg
ip address   dk5sg
netrom ident "#fc"

attach axip                     # ax.25 over host ip
attach ipip                     # ip over host ip
attach netrom                   # ip over netrom
attach ni ni dk5sg-u            # ip to host ip

ax25 route add axip default

axip route add dk0hu 15.136.56.6 # hp0hu.bbn.hp.com

route add  dk5sg-u          ni
route add  44.142.52/23     ipip     15.136.56.6
route add  44.130/16        ipip     15.136.56.6
route addp 44/8             ipip     15.255.240.16
route addp 15/8             ni

source /tcp/netrom_links

# netrom broadcast axip nodes

domain usegethostby on
echo accept
icmp trace on
ip rtimer 100
ip ttl 30
log /tcp/net.log
tcp irtt 60000
tcp mss 216
tcp window 2048

start discard
start domain
start echo
start ftp
start remote
start tcpgate convers unix:/tcp/sockets/convers
start tcpgate finger
start tcpgate netupds
start tcpgate nntp
start tcpgate smtp

source /tcp/net.rc.local
