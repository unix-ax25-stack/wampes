# @(#) $Header: /Users/thomas/direwolf-libax25-agwpe/wampes-import/wampes-cvs/wampes/net.rc.dk5sg,v 1.15 1993/10/10 08:19:25 deyke Exp $

hostname     dk5sg
ax25 mycall  dk5sg
ip address   dk5sg
netrom ident "#fc"

attach axip                     # ax.25 over host ip
attach ipip                     # ip over host ip
attach netrom                   # ip over netrom
attach ni ni dk5sg-u            # ip to host ip

ax25 route add axip default

axip route add dk0hu 15.138.33.250 # hp0hu.bbn.hp.com

route add  dk5sg-u.ampr.org     ni
route add  44.142.52.0/23       ipip     15.138.33.250
route add  44.130.0.0/16        ipip     15.138.33.250
route addp 44.0.0.0/8           ipip     15.255.240.16
route addp 15.0.0.0/8           ni

source /tcp/netrom_links

# netrom broadcast axip nodes

domain usegethostby on
echo accept
icmp trace on
ip rtimer 300
ip ttl 30
log /tcp/net.log
tcp irtt 60000
tcp mss 216
tcp window 2048

start discard
start domain
start echo
start ftp
start remote
start tcpgate convers unix:/tcp/sockets/convers
start tcpgate finger
start tcpgate netupds
start tcpgate nntp
start tcpgate smtp

source /tcp/net.rc.local
