# @(#) $Header: /Users/thomas/direwolf-libax25-agwpe/wampes-import/wampes-cvs/wampes/Attic/net.rc.dl4sel-1,v 1.7 1993/03/02 12:50:49 deyke Exp $

hostname     dl4sel-1
ax25 mycall  dl4sel-1
ip address   dl4sel-1
netrom ident "#boeb2"

attach axip                     # ax.25 over host ip
attach ipip                     # ip over host ip
attach netrom                   # ip over netrom

ax25 route add axip default

axip route add dk0hu 15.136.56.6

route add  44.142.52/23     ipip     15.136.56.6
route add  44.130/16        ipip     15.136.56.6

source /tcp/netrom_links

# netrom broadcast axip nodes

echo accept
icmp trace on
ip rtimer 100
ip ttl 30
log /tcp/net.log
tcp irtt 20000
tcp mss 216
tcp window 2048

smtp timer 300
start discard
start domain
start echo
start ftp
start remote
start tcpgate convers unix:/tcp/sockets/convers
start tcpgate smtp

source /tcp/net.rc.local
