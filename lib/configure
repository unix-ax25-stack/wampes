# @(#) $Id: configure,v 1.45 2016/03/13 14:44:57 dl9sau Exp $

CC='cc'
CFLAGS='-O -I../lib'

LD='$(CC)'
LDFLAGS='$(CFLAGS) '"${STRIPFLAG-"-s"}"

LIBS='../lib/libutil.a'
SLIBS=''

TCPDIR=${TCPDIR:-}

MKDIR='@if [ ! -d `dirname $@` ]; then mkdir -p `dirname $@`; fi'
RMTARGET='@if [ -f $@ ]; then rm -f $@ || mv -f $@ $@~; fi'

case "`uname -sr`" in

HP-UX*)
	CC='c89'
	if hp9000s800; then
		CFLAGS="$CFLAGS -z +ESlit -D_HPUX_SOURCE -DFD_SETSIZE=1024"
	else
		CFLAGS="$CFLAGS -D_HPUX_SOURCE -DFD_SETSIZE=1024"
	fi
	SLIBS='-lndbm'
	;;

AIX*)
	CFLAGS="$CFLAGS -qchars=signed -D_ALL_SOURCE -DFD_SETSIZE=1024"
	;;

IRIX64*)
	CFLAGS="$CFLAGS -signed -TENV:large_stack -DFD_SETSIZE=1024"
	;;

IRIX*)
	CFLAGS="$CFLAGS -signed -framepointer -DFD_SETSIZE=1024"
	;;

Linux*)
	CC='gcc'
	case `hostname` in
	server.deyke.net)
		CFLAGS="$CFLAGS -fsigned-char -ansi -pedantic -Wall -Wshadow -Wpointer-arith -Wstrict-prototypes -Wnested-externs -Dlinux -D_GNU_SOURCE -I../src/linux_include";;
	*)
		CFLAGS="$CFLAGS -I../src/linux_include";;
	esac
	if [ -f /usr/lib/libndbm.so -o -f /usr/lib/libndbm.a ]; then
		LIBDBM='ndbm'
	elif [ -f /usr/lib/libgdbm_compat.so -o -f /usr/lib/libgdbm_compat.a ]; then
		LIBDBM='gdbm_compat'
	elif [ -f /usr/lib/libgdbm.so -o -f /usr/lib/libgdbm.a -o -f /usr/lib64/libgdbm.so -o -f /usr/lib64/libgdbm.a -o -f /usr/lib/x86_64-linux-gnu/libgdbm.a -o -f /usr/lib/x86_64-linux-gnu/libgdbm.so ]; then
		LIBDBM='gdbm'
	elif [ -f /usr/lib/libdbm.so -o -f /usr/lib/libdbm.a ]; then
		LIBDBM='dbm'
	else
		echo Cannot find a dbm library
		exit 1
	fi
	SLIBS="-l$LIBDBM"

	case `uname -m` in
	sparc*)
		CFLAGS="$CFLAGS -DSINGLE_THREADED";;
	esac
	;;

386BSD*)
	CFLAGS="$CFLAGS -DFD_SETSIZE=1024"
	;;

NetBSD*)
	CFLAGS="$CFLAGS -DFD_SETSIZE=1024"
	SLIBS='-L/usr/pkg/lib -lcrypt -lgdbm'
	;;

FreeBSD*)
	CFLAGS="$CFLAGS -DFD_SETSIZE=1024"
	SLIBS='-lcrypt'
	;;

BSD/386*)
	CFLAGS="$CFLAGS -DFD_SETSIZE=1024"
	;;

SunOS\ 4.*)
	CC='acc'
	CFLAGS="$CFLAGS -DFD_SETSIZE=1024"
	;;

SunOS\ 5.*)
	CFLAGS="$CFLAGS -v -DFD_SETSIZE=1024"
	SLIBS='-lsocket -lnsl'
	;;

ULTRIX*)
	CC='gcc'
	CFLAGS="$CFLAGS -DULTRIX_RISC -DFD_SETSIZE=64"
	SLIBS='-ldbm'
	;;

A/UX*)
	CC='gcc'
	CFLAGS="$CFLAGS -fpcc-struct-return -D_POSIX_SOURCE"
	SLIBS='-ldbm -lposix'
	;;

RISC\ iX*)
	CC='../cc'
	CFLAGS='-DRISCiX -I../lib'
	;;

AOS*)
	CC='gcc'
	CFLAGS="$CFLAGS -Dibm6153"
	LIBS="../aos/libaos.a $LIBS"
	LDFLAGS='-g'
	;;

NeXT*)
	CC='gcc'
	CFLAGS="$CFLAGS -posix -D_POSIX_SOURCE -DFD_SETSIZE=256"
	LIBS="../NeXT/libnext.a $LIBS"
	SLIBS='-ldbm'
	;;

Darwin*)
	CC='gcc'
	CFLAGS="$CFLAGS -D__MACOSX__"
	TCPDIR=${TCPDIR:-/usr/local/wampes}
	;;

esac

# The feature probes further down (checksymbol, the fd_set test) compile with
# $CFLAGS.  Keep a pristine copy for them: extra flags can make those probes
# fail, which would silently turn every HAS_* into 0 and mis-configure the
# build.
PROBE_CFLAGS="$CFLAGS"

# Optional hooks for one-off builds.  All three are empty/default unless set
# in the environment, so a normal build is bit-for-bit unchanged.
#
#   EXTRA_CFLAGS    appended to CFLAGS; reaches the link too, because
#                   LDFLAGS starts with $(CFLAGS)
#   EXTRA_LDFLAGS   appended to LDFLAGS only
#   STRIPFLAG       link-time strip flag, "-s" by default; set it empty to
#                   keep symbols (needed for readable sanitizer output, and
#                   "-s" is deprecated on recent macOS linkers)
#
# UBSan build that fails hard on the first finding:
#
#   EXTRA_CFLAGS='-O1 -g -fno-omit-frame-pointer -fsanitize=undefined -fno-sanitize-recover=all' \
#   STRIPFLAG= ./configure
#
# Note: -fsanitize=address does NOT work with the ucontext-based scheduler in
# src/kernel.c without __sanitizer_{start,finish}_switch_fiber annotations.
CFLAGS="$CFLAGS${EXTRA_CFLAGS:+ $EXTRA_CFLAGS}"
LDFLAGS="$LDFLAGS${EXTRA_LDFLAGS:+ $EXTRA_LDFLAGS}"

TCPDIR=${TCPDIR:-/tcp}

# Where the programs go.  Everything WAMPES installs lives under TCPDIR by
# default, so that a local installation is one directory that can be moved,
# backed up or deleted as a unit, and so that its names cannot collide with
# another project's.  A distribution package overrides these:
#
#   BINDIR=/usr/bin SBINDIR=/usr/sbin PUBLICBINDIR= ./configure
#
# PUBLICBINDIR is the shared directory that gets "wampes-" prefixed symlinks
# to the handful of commands a person actually types, so that they are on the
# usual PATH without occupying a plain name there.  Empty means no symlinks.
BINDIR=${BINDIR:-$TCPDIR/bin}
SBINDIR=${SBINDIR:-$TCPDIR/sbin}
PUBLICBINDIR=${PUBLICBINDIR-/usr/local/bin}

rm -f configure.mak

echo 'CC='"'$CC'" >> configure.mak
echo 'CFLAGS='"'$CFLAGS'" >> configure.mak

echo 'LD='"'$LD'" >> configure.mak
echo 'LDFLAGS='"'$LDFLAGS'" >> configure.mak

echo 'LIBS='"'$LIBS'" >> configure.mak
echo 'SLIBS='"'$SLIBS'" >> configure.mak

echo 'TCPDIR='"'$TCPDIR'" >> configure.mak
echo 'BINDIR='"'$BINDIR'" >> configure.mak
echo 'SBINDIR='"'$SBINDIR'" >> configure.mak
echo 'PUBLICBINDIR='"'$PUBLICBINDIR'" >> configure.mak
echo 'MKDIR='"'$MKDIR'" >> configure.mak
echo 'RMTARGET='"'$RMTARGET'" >> configure.mak

echo 'export CC CFLAGS LD LDFLAGS LIBS SLIBS TCPDIR BINDIR SBINDIR PUBLICBINDIR MKDIR RMTARGET' >> configure.mak

islink='-h'

case "`uname -sr`" in
AIX*)
	islink='-L';;
IRIX*)
	islink='-L';;
Linux*)
	islink='-L';;
AOS*)
	islink='-L';;
esac

tmp=tmp$$

findfile()
{
	name=$1
	shift
	for i in $*; do
		if [ -f $i -a ! $islink $i ]; then
			echo "#define ${name} \"$i\""
			return
		fi
	done
	echo "#define ${name} \"\""
}

findprog()
{
	name=$1
	shift
	for i in $*; do
		if [ -f $i -a -x $i -a ! $islink $i ]; then
			echo "#define ${name} \"$i\""
			return
		fi
	done
	for i in $*; do
		if [ -f $i -a -x $i ]; then
			echo "#define ${name} \"$i\""
			return
		fi
	done
	for i in $*; do
		if [ -f $i -a ! $islink $i ]; then
			echo "#define ${name} \"$i\""
			return
		fi
	done
	for i in $*; do
		if [ -f $i ]; then
			echo "#define ${name} \"$i\""
			return
		fi
	done
	echo "#define ${name} \"\""
}

finddir()
{
	name=$1
	shift
	for i in $*; do
		if [ -d $i -a ! $islink $i ]; then
			echo "#define ${name} \"$i\""
			return
		fi
	done
	for i in $*; do
		if [ -d $i ]; then
			echo "#define ${name} \"$i\""
			return
		fi
	done
	echo "#define ${name} \"\""
}

checksymbol()
{
	echo "$2" >$tmp.c
	if $CC $PROBE_CFLAGS $tmp.c $SLIBS -o $tmp >/dev/null 2>&1; then
		echo "#define $1 1"
	else
		echo "#define $1 0"
	fi
}

(

	echo "#ifndef _CONFIGURE_H"
	echo "#define _CONFIGURE_H"
	echo

	finddir HOME_DIR \
		/home \
		/Users \
		/users \
		/usr/people \
		/u

	finddir NEWS_DIR \
		/usr/local/news/spool \
		/var/spool/news \
		/usr/spool/news

	finddir UUCP_DIR \
		/var/spool/uucp \
		/usr/spool/uucp

	echo

	findfile UTMP__FILE \
		/var/run/utmp \
		/var/adm/utmp \
		/etc/utmp

	findfile WTMP__FILE \
		/var/log/wtmp \
		/var/adm/wtmp \
		/usr/adm/wtmp \
		/etc/wtmp

	echo

	findprog CTLINND_PROG \
		/usr/local/news/bin/ctlinnd \
		/usr/lib/news/bin/ctlinnd \
		/usr/bin/ctlinnd

	findprog LS_PROG \
		/usr/bin/ls \
		/bin/ls

	findprog MAIL_PROG \
		/usr/openwin/bin/xview/mail \
		/usr/bin/mailx \
		/bin/mailx \
		/usr/sbin/Mail \
		/usr/bin/mail \
		/bin/mail

	findprog RNEWS_PROG \
		/usr/local/news/bin/rnews \
		/usr/local/bin/rnews \
		/usr/bin/rnews \
		/usr/lib/news/rnews \
		/usr/lib/rnews

	findprog SENDMAIL_PROG \
		/usr/sbin/sendmail \
		/usr/lib/sendmail

	echo

	# Every probe below must be valid C99 or later.  They used to be written
	# as "main(){...}" with an implicit int return type, which C99 removed
	# and which clang 15 and gcc 14 reject outright - so on a current
	# toolchain every single probe failed to compile and every HAS_* came
	# out 0, silently selecting the "feature absent" branch everywhere.
	# Note that this fails quietly: nothing warns, the build just uses the
	# fallbacks.  Keep the "int main(void)" and the includes.

	checksymbol HAS_ADJTIME \
		"#include <sys/time.h>
		 int main(void){adjtime(0,0);return 0;}"

	checksymbol HAS_INT32 \
		"#include <sys/types.h>
		 int main(void){int32 f=0;return f;}"

	checksymbol HAS_NDBM \
		"#include <ndbm.h>
		 int main(void){dbm_open(0, 0, 0);return 0;}"

	checksymbol HAS_DB1_NDBM \
		"#include <db1/ndbm.h>
		 int main(void){dbm_open(0, 0, 0);return 0;}"

	checksymbol HAS_GDBM_NDBM \
		"#include <gdbm-ndbm.h>
		 int main(void){dbm_open(0, 0, 0);return 0;}"

	checksymbol HAS_GDBM \
		"#include <gdbm.h>
		 int main(void){gdbm_open(0, 0, 0, 0, 0);return 0;}"

	checksymbol HAS_NI \
		"#include <net/if_ni.h>
		 struct ni_desc x;
		 int main(void){return 0;}"

	checksymbol HAS_STRDUP \
		"#include <string.h>
		 int main(void){strdup(\"x\");return 0;}"

	checksymbol HAS_STRERROR \
		"#include <string.h>
		 int main(void){strerror(0);return 0;}"

	checksymbol HAS_STRTOUL \
		"#include <stdlib.h>
		 int main(void){strtoul(\"0\",0,0);return 0;}"

	checksymbol HAS_UINT \
		"#include <sys/types.h>
		 int main(void){uint f=0;return f;}"

	checksymbol HAS_UCONTEXT \
		"#include <ucontext.h>
		 ucontext_t x;
		 int main(void){return 0;}"

	# IPv6 for the host sockets built by build_sockaddr().  This is about
	# the outer transport only - WAMPES' own IP stack stays IPv4.
	# -DNO_AF_INET6 forces it off in the source regardless of this.
	checksymbol HAS_AF_INET6 \
		"#include <sys/types.h>
		 #include <sys/socket.h>
		 #include <netdb.h>
		 #include <netinet/in.h>
		 struct sockaddr_in6 sa6;
		 int main(void){struct addrinfo *r;
			getaddrinfo(\"::1\", 0, 0, &r);
			return IN6_IS_ADDR_V4MAPPED(&sa6.sin6_addr);}"

	# utmp bookkeeping.  On Darwin the API still exists but is vestigial:
	# the system keeps its login records in utmpx, /var/run/utmp is not
	# maintained, and <utmp.h> is marked deprecated.  Nothing WAMPES writes
	# there is ever read back, so do not write it.
	case "`uname -sr`" in
	Darwin*)
		echo "#define HAS_UTMP 0";;
	*)
		checksymbol HAS_UTMP \
			"#include <utmp.h>
			 struct utmp u;
			 int main(void){pututline(&u);endutent();return 0;}";;
	esac

	echo

	echo "
	#include <sys/types.h>
	#ifdef _AIX
	#include <sys/select.h>
	#endif
	int main(void){fd_set f;return sizeof(f)>0;}
	" >$tmp.c
	if $CC $PROBE_CFLAGS $tmp.c -o $tmp >/dev/null 2>&1; then
		echo "#define TYPE_FD_SET fd_set"
	else
		echo "#define TYPE_FD_SET struct fd_set"
	fi

	echo
	echo "#define TCPDIR \"$TCPDIR\""
	echo "#define BINDIR \"$BINDIR\""

	echo
	echo "#ifdef __MACOSX__"
	echo "#undef HAS_NDBM"
	echo "#undef HAS_DB1_NDBM"
	echo "#undef HAS_GDBM_NDBM"
	echo "#undef HAS_GDBM"
	echo "#define HAS_NDBM 1"
	echo "#endif"

	echo
	echo "#endif"

) > configure.tmp

if cmp -s configure.tmp configure.h; then
	rm -f configure.tmp
else
	rm -f configure.h
	mv configure.tmp configure.h
fi

rm -f $tmp*
